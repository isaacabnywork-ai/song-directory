generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Song {
  id            Int             @id @default(autoincrement())
  title         String
  artist        String
  year          Int
  category      String
  lyrics        String?
  sungCount     Int             @default(0)
  audioUrl      String?
  history       SongHistory[]
  sundaySetlist SundaySetlist?
}

model SongHistory {
  id     Int      @id @default(autoincrement())
  songId Int
  sungAt DateTime @default(now())
  song   Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
}

model SundaySetlist {
  id     Int  @id @default(autoincrement())
  songId Int  @unique
  order  Int  @default(0)
  song   Song @relation(fields: [songId], references: [id], onDelete: Cascade)
}

model ServiceItem {
  id          Int      @id @default(autoincrement())
  startTime   String?
  endTime     String?
  event       String
  responsible String?
  content     String?
  isHeader    Boolean  @default(false)
  order       Int      @default(0)
}

model ServiceOrderHistory {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique
  items     Json
  createdAt DateTime @default(now())
}
